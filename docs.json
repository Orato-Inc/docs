{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Orato",
  "colors": {
    "primary": "#C4622D",
    "light": "#C4622D",
    "dark": "#8B3E18"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "home",
              "introduction",
              "platform",
              "quick-start"
            ]
          },
          {
            "group": "Build assistants",
            "pages": [
              "ai-assistant",
              "assistants/prompt",
              "assistants/voice-and-language",
              "assistants/settings",
              "assistants/advanced",
              "assistants/branding",
              "assistant-templates"
            ]
          },
          {
            "group": "Inventory",
            "pages": [
              "knowledge-base",
              "phone-numbers"
            ]
          },
          {
            "group": "Deploy",
            "pages": [
              "leads",
              "campaigns",
              "calls/outbound",
              "calls/inbound"
            ]
          },
          {
            "group": "Monitor",
            "pages": [
              "dashboard",
              "calls",
              "conversations",
              "meetings"
            ]
          },
          {
            "group": "Manage account",
            "pages": [
              "account/settings",
              "account/team-and-roles",
              "account/billing"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "prompting-guide",
              "providers",
              "multilingual"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/ticketing",
              "integrations/google-calendar",
              "integrations/messaging-and-notifications"
            ]
          }
        ]
      },
      {
        "tab": "Developer",
        "groups": [
          {
            "group": "Developer",
            "pages": [
              "api-reference/introduction",
              "developer/api-keys",
              "developer/widget-integration"
            ]
          }
        ]
      },
      {
        "tab": "Tutorials",
        "groups": [
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/overview",
              "tutorials/lead-qualification-campaign",
              "tutorials/inbound-receptionist",
              "tutorials/website-voice-assistant",
              "tutorials/hindi-assistant"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/orato-logo-horizontal-header-1200.png",
    "dark": "/images/orato-logo-horizontal-header-1200.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tryorato.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.tryorato.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/OratoInc",
      "linkedin": "https://www.linkedin.com/company/tryorato",
      "youtube": "https://www.youtube.com/@Orato-inc",
      "instagram": "https://www.instagram.com/orato.inc/",
      "facebook": "https://www.facebook.com/Orato.inc"
    }
  },
  "fonts": {
    "family": "Inter",
    "weight": 200
  },
  "favicon": "/images/orato-logo-app-icon-512.png",
  "redirects": [
    {
      "source": "/calls/batch-calling",
      "destination": "/campaigns"
    },
    {
      "source": "/calls/call-history",
      "destination": "/calls"
    },
    {
      "source": "/function-calls/introduction",
      "destination": "/assistants/advanced"
    },
    {
      "source": "/function-calls/transfer-calls",
      "destination": "/assistants/advanced"
    },
    {
      "source": "/function-calls/:slug*",
      "destination": "/assistants/advanced"
    },
    {
      "source": "/multilingual/:slug*",
      "destination": "/multilingual"
    }
  ]
}